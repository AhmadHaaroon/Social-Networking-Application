<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/login"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/seashell"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    tools:context=".MainActivity">

    <LinearLayout
        android:id="@+id/login_header"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="5"
        android:orientation="vertical"
        android:paddingTop="20dp"
        android:gravity="center">
        <LinearLayout
            android:id="@+id/login_header_dropdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">
            <TextView
                android:id="@+id/login_header_dropdown_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:text="English (UK) "
                android:textStyle="bold"
                android:textColor="@color/wenge"/>
            <ImageView
                android:id="@+id/login_header_dropdown_icon"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:src="@drawable/chevron_down"
                android:layout_gravity="center"
                app:tint="@color/wenge"/>
        </LinearLayout>
        <ImageView
            android:id="@+id/login_header_logo"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:layout_margin="20dp"
            android:background="@drawable/logo_background"
            android:src="@drawable/logo"
            android:padding="15dp"
            android:clipToOutline="true">
        </ImageView>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/login_main"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="13"
        android:orientation="vertical">

        <TextView
            android:id="@+id/login_main_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="RECENT LOGIN"
            android:textStyle="bold"
            android:textSize="12sp"
            android:textAlignment="textStart"
            android:textColor="@color/wenge"
            android:layout_marginHorizontal="20dp"/>
        <LinearLayout
            android:id="@+id/login_main_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/white_rectangle_rounded_greygoose_stroke"
            android:orientation="horizontal"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="15dp"
            android:padding="5dp">
            <RelativeLayout
                android:id="@+id/login_main_card_profile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:id="@+id/login_main_card_profile_image"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:background="@drawable/teal_circle"
                    android:text="JW"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:textSize="20sp"
                    android:layout_centerInParent="true"
                    android:gravity="center"
                    android:layout_margin="10dp"/>
                <TextView
                    android:id="@+id/login_main_card_profile_notification"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:background="@drawable/chestnutred_circle_white_stroke"
                    android:text="2"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:layout_alignTop="@id/login_main_card_profile_image"
                    android:layout_alignEnd="@id/login_main_card_profile_image"
                    android:gravity="center"
                    android:layout_marginTop="-2dp"
                    android:layout_marginEnd="-2dp"/>
            </RelativeLayout>
            <LinearLayout
                android:id="@+id/login_main_card_account"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="6"
                android:orientation="vertical"
                android:gravity="center_vertical">
                <TextView
                    android:id="@+id/login_main_card_account_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Jacob West"
                    android:textColor="@color/black"
                    android:textSize="18sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/login_main_card_account_prompt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tap to log in"
                    android:textColor="@color/wenge"
                    android:textSize="14sp"/>
            </LinearLayout>
            <ImageView
                android:id="@+id/login_main_card_setting"
                android:layout_width="0dp"
                android:layout_height="25dp"
                android:layout_weight="1"
                android:src="@drawable/dots_horizontal"
                android:layout_gravity="center_vertical"
                app:tint="@color/wenge"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/login_main_email"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/white_rectangle_rounded_greygoose_stroke"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="10dp"
            android:paddingHorizontal="18dp"
            android:paddingVertical="9dp">
            <LinearLayout
                android:id="@+id/login_main_email_layout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/login_main_email_layout_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Mobile number or email"
                    android:textSize="12sp"
                    android:textColor="@color/wenge"/>
                <EditText
                    android:id="@+id/login_main_email_layout_entry"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textColor="@color/black"
                    android:background="@null"
                    android:layout_marginTop="5dp"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/login_main_password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/white_rectangle_rounded_greygoose_stroke"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="10dp"
            android:paddingHorizontal="18dp"
            android:paddingVertical="9dp">
            <LinearLayout
                android:id="@+id/login_main_password_layout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/login_main_password_layout_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Password"
                    android:textSize="12sp"
                    android:textColor="@color/wenge"/>
                <EditText
                    android:id="@+id/login_main_password_layout_entry"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textColor="@color/black"
                    android:inputType="textPassword"
                    android:background="@null"
                    android:layout_marginTop="5dp"/>
            </LinearLayout>
            <ImageView
                android:id="@+id/login_main_password_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginHorizontal="8dp"
                android:src="@drawable/visibility"
                app:tint="@color/wenge"
                android:layout_gravity="center"/>
        </LinearLayout>
        <Button
            android:id="@+id/login_main_loginbutton"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="10dp"
            android:text="Log in"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:background="@drawable/teal_rectangle_rounded"
            app:backgroundTint="@null" />
        <TextView
            android:id="@+id/login_main_forgetpassword"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Forgot password?"
            android:textSize="13sp"
            android:textColor="@color/teal"
            android:textStyle="bold"
            android:layout_gravity="center"
            android:layout_marginTop="18dp"
            android:textAllCaps="false"/>

    </LinearLayout>
    <LinearLayout
        android:id="@+id/login_spacer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2"
        android:orientation="vertical"
        android:gravity="center">

    </LinearLayout>
    <LinearLayout
        android:id="@+id/login_footer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="4"
        android:orientation="vertical"
        android:gravity="center">
        <Button
            android:id="@+id/login_footer_createaccountbutton"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="10dp"
            android:text="Create new account"
            android:textStyle="bold"
            android:textColor="@color/teal"
            android:textSize="15sp"
            app:backgroundTint="@null"
            android:background="@drawable/transparent_rectangle_rounded_teal_stroke"/>
        <LinearLayout
            android:id="@+id/login_footer_subtext"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">
            <ImageView
                android:id="@+id/login_footer_subtext_logo"
                android:layout_width="20dp"
                android:layout_height="18dp"
                android:src="@drawable/logo_transparent"
                android:layout_gravity="center"
                app:tint="@color/wenge"
                android:layout_marginTop="1dp"/>
            <TextView
                android:id="@+id/login_footer_subtext_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Kinnect · from SMD"
                android:textSize="12sp"
                android:layout_marginHorizontal="5dp"
                android:layout_marginVertical="10dp"/>
        </LinearLayout>
    </LinearLayout>


</LinearLayout>